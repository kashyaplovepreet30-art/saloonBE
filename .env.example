DJANGO_DEBUG=False
DJANGO_SECRET_KEY=your-production-secret-key
DJANGO_ALLOWED_HOSTS=saloonbe.onrender.com,localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Kolkata

# Option A: Single DATABASE_URL (Render PostgreSQL or hosted MySQL connection URL)
# DATABASE_URL=postgres://user:password@host:5432/dbname
# DATABASE_URL=mysql://user:password@host:3306/dbname

# Option B: Individual MySQL environment variables
DB_ENGINE=django.db.backends.mysql
DB_NAME=salon_db
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=your_live_mysql_host.com
DB_PORT=3306

CORS_ALLOWED_ORIGINS=https://your-frontend-domain.onrender.com,http://localhost:5173
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_CURRENCY=INR